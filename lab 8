import re
import sqlite3

students = [
    {"name": "Aida", "group": "IS-24-01", "score": 82, "attendance": 91, "email": "aida@atu.edu.kz"},
    {"name": "Miras", "group": "IS-24-01", "score": 69, "attendance": 88, "email": "miras@atu.edu.kz"},
    {"name": "Dana", "group": "IS-24-02", "score": 91, "attendance": 96, "email": "dana@atu.edu.kz"},
    {"name": "Timur", "group": "IS-24-02", "score": 74, "attendance": 62, "email": "timur_at_atu.kz"},
    {"name": "Aliya", "group": "IS-24-03", "score": 87, "attendance": 79, "email": "aliya@atu.edu.kz"},
    {"name": "Arman", "group": "IS-24-03", "score": 55, "attendance": 72, "email": "arman@atu.edu.kz"}
]

group_pattern = r"[A-Z]{2}-\d{2}-\d{2}"
email_pattern = r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"


def header(title):
    print("\n" + "=" * 45)
    print(title)
    print("=" * 45)


header("TASK 1: Comparison of Programming Styles")

passed_imperative = []
for student in students:
    if student["score"] >= 75:
        passed_imperative.append(student["name"])

passed_declarative = [
    student["name"] for student in students
    if student["score"] >= 75
]

print("Imperative result:", passed_imperative)
print("Declarative result:", passed_declarative)
print("Results are identical:", passed_imperative == passed_declarative)


header("TASK 2: Collection Conditions")

print("There is an excellent student:",
      any(student["score"] >= 90 for student in students))

print("All students have attendance of at least 60%:",
      all(student["attendance"] >= 60 for student in students))

print("Average score:",
      round(sum(student["score"] for student in students) / len(students), 1))

students_modified = [dict(student) for student in students]
students_modified[3]["attendance"] = 55

print("All attendance values are at least 60% after changing Timur's attendance:",
      all(student["attendance"] >= 60 for student in students_modified))


header("TASK 3: Regular Expression Validation")

invalid_groups = [
    student["group"] for student in students
    if not re.fullmatch(group_pattern, student["group"])
]

invalid_emails = [
    student["email"] for student in students
    if not re.fullmatch(email_pattern, student["email"])
]

print("Invalid groups:", invalid_groups)
print("Invalid email addresses:", invalid_emails)

for student in students:
    if student["name"] == "Timur":
        student["email"] = "timur@atu.edu.kz"

print("Invalid emails after correction:", [
    student["email"] for student in students
    if not re.fullmatch(email_pattern, student["email"])
])


connection = sqlite3.connect(":memory:")
cursor = connection.cursor()

cursor.execute("""
CREATE TABLE students (
    name TEXT NOT NULL,
    group_name TEXT NOT NULL,
    score INTEGER NOT NULL,
    attendance INTEGER NOT NULL,
    email TEXT NOT NULL
)
""")

cursor.executemany(
    "INSERT INTO students VALUES (?, ?, ?, ?, ?)",
    [
        (
            student["name"],
            student["group"],
            student["score"],
            student["attendance"],
            student["email"]
        )
        for student in students
    ]
)

connection.commit()


header("TASK 4: SQLite Database Creation")
print("The database was created and populated successfully.")


header("TASK 5: Declarative SQL Queries")

cursor.execute("""
SELECT name, score, attendance
FROM students
WHERE score >= 75 AND attendance >= 70
ORDER BY score DESC
""")

print("Students with score >= 75 and attendance >= 70%:")
for row in cursor.fetchall():
    print(f"{row[0]}: score {row[1]}, attendance {row[2]}%")

cursor.execute("""
SELECT group_name, COUNT(*), ROUND(AVG(score), 1)
FROM students
GROUP BY group_name
HAVING AVG(score) >= 70
ORDER BY AVG(score) DESC
""")

print("\nGroup statistics:")
for row in cursor.fetchall():
    print(f"{row[0]}: students {row[1]}, average score {row[2]}")


header("TASK 6: Integrated Result")

cursor.execute("""
SELECT name, group_name, score, email
FROM students
WHERE score >= 70 AND attendance >= 70
ORDER BY score DESC
""")

result = [
    row for row in cursor.fetchall()
    if re.fullmatch(email_pattern, row[3])
]

if result:
    print("Ranking of eligible students with valid email addresses:")
    for place, row in enumerate(result, start=1):
        print(f"{place}. {row[0]} | {row[1]} | Score: {row[2]} | {row[3]}")
else:
    print("No students meet the requirements.")


def run_variant(number):
    cursor.executemany(
        "INSERT INTO students VALUES (?, ?, ?, ?, ?)",
        [
            ("Askar", "IS-24-01", 95, 92, "askar@atu.edu.kz"),
            ("Bota", "IS-24-01", 45, 50, "bota@gmail.com")
        ]
    )

    try:
        header(f"INDIVIDUAL VARIANT {number}")

        if number == 1:
            cursor.execute("""
            SELECT name, score, email
            FROM students
            WHERE score >= 90 AND group_name = ?
            """, ("IS-24-01",))

            rows = [
                row for row in cursor.fetchall()
                if re.fullmatch(
                    r"[A-Za-z0-9._%+-]+@atu\.edu\.kz", row[2]
                )
            ]

            print("Excellent students in group IS-24-01:")
            for row in rows:
                print(f"{row[0]}: score {row[1]}, email {row[2]}")

        elif number == 2:
            score_limit = int(input("Enter the score limit: "))
            attendance_limit = int(input("Enter the attendance limit: "))

            cursor.execute("""
            SELECT name, group_name, score, attendance
            FROM students
            WHERE score < ? AND attendance < ?
            """, (score_limit, attendance_limit))

            rows = [
                row for row in cursor.fetchall()
                if re.fullmatch(group_pattern, row[1])
            ]

            if rows:
                for row in rows:
                    print(
                        f"At-risk student: {row[0]} ({row[1]}), "
                        f"score {row[2]}, attendance {row[3]}%"
                    )
            else:
                print("No at-risk students found.")

        elif number == 3:
            cursor.execute("""
            SELECT group_name, COUNT(*)
            FROM students
            WHERE score >= 70 AND attendance >= 70
            GROUP BY group_name
            """)

            print("Number of students eligible for the exam:")
            for row in cursor.fetchall():
                print(f"Group {row[0]}: {row[1]} students")

        elif number == 4:
            cursor.execute("""
            SELECT group_name, COUNT(*), ROUND(AVG(score), 1)
            FROM students
            GROUP BY group_name
            HAVING COUNT(*) >= 2 AND AVG(score) >= 80
            ORDER BY AVG(score) DESC
            """)

            print("Best groups:")
            for row in cursor.fetchall():
                print(
                    f"Group {row[0]}: students {row[1]}, "
                    f"average score {row[2]}"
                )

        elif number == 5:
            cursor.execute("""
            SELECT name, score, attendance
            FROM students
            WHERE attendance >= 85 AND score >= 60
            """)

            rows = cursor.fetchall()
            print("Active students:")

            for row in rows:
                print(
                    f"{row[0]}: score {row[1]}, "
                    f"attendance {row[2]}%"
                )

            print(
                "Is there an excellent student among them:",
                any(row[1] >= 90 for row in rows)
            )

        elif number == 6:
            cursor.execute("""
            SELECT name, score, email
            FROM students
            WHERE score BETWEEN 50 AND 74
            """)

            rows = cursor.fetchall()
            print("Students referred for consultation:")

            for row in rows:
                print(f"{row[0]}: score {row[1]}, email {row[2]}")

            print(
                "Are all email addresses valid:",
                all(
                    re.fullmatch(email_pattern, row[2])
                    for row in rows
                )
            )

        elif number == 7:
            cursor.execute("SELECT name, email FROM students")
            rows = cursor.fetchall()

            invalid = [
                row for row in rows
                if not re.fullmatch(email_pattern, row[1])
            ]

            print("Records with invalid email addresses:", invalid)

            corrections = [
                (name, email.replace("_at_", "@"))
                for name, email in invalid
            ]

            print("Suggested corrections:", corrections)

        elif number == 8:
            cursor.execute("""
            SELECT group_name, COUNT(*), ROUND(AVG(score), 1)
            FROM students
            GROUP BY group_name
            """)

            rows = cursor.fetchall()
            print("Group summary:")

            for row in rows:
                print(
                    f"Group {row[0]}: students {row[1]}, "
                    f"average score {row[2]}"
                )

            if rows:
                best_group = max(rows, key=lambda row: row[2])
                print(
                    f"Group with the highest average score: "
                    f"{best_group[0]} ({best_group[2]})"
                )

        elif number == 9:
            cursor.execute("""
            SELECT name, group_name, score
            FROM students
            WHERE score >= 70
            """)

            rows = [
                row for row in cursor.fetchall()
                if re.fullmatch(r"A.*", row[0])
            ]

            print("Students whose names start with A and score >= 70:")

            for row in rows:
                print(f"{row[0]} ({row[1]}): {row[2]} points")

            if not rows:
                print("No matching students found.")

        elif number == 10:
            threshold = int(input("Enter the minimum score: "))

            cursor.execute("""
            SELECT name, score, attendance
            FROM students
            WHERE score >= ? AND attendance >= 65
            """, (threshold,))

            rows = cursor.fetchall()
            print(
                f"Students with score >= {threshold} "
                "and attendance >= 65%:"
            )

            if rows:
                for row in rows:
                    print(
                        f"{row[0]}: score {row[1]}, "
                        f"attendance {row[2]}%"
                    )
            else:
                print("No matching students found.")

    except ValueError:
        print("Error: please enter a valid number.")

    finally:
        cursor.execute(
            "DELETE FROM students WHERE name IN ('Askar', 'Bota')"
        )
        connection.commit()


try:
    variant = int(input("\nEnter an individual variant (1-10): "))

    if 1 <= variant <= 10:
        run_variant(variant)
    else:
        print("Please enter a number from 1 to 10.")

except ValueError:
    print("Error: please enter an integer.")

finally:
    connection.close()
